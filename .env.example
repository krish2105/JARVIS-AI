# Copy this file to .env and fill in your own values. Never commit .env.

# Anthropic API key — used for the reasoning ("brain") step only.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Picovoice Porcupine access key — free for personal use.
# https://console.picovoice.ai/
PICOVOICE_ACCESS_KEY=

# Wake word Jarvis listens for. Use a stock keyword (e.g. "computer", "jarvis"
# if available in your Porcupine console) or the path to a custom trained
# .ppn model file if you trained "Jarvis" at https://console.picovoice.ai/.
JARVIS_WAKE_WORD=jarvis

# Optional: path to a custom Porcupine .ppn keyword model file, if you trained
# one instead of using a stock keyword name above.
JARVIS_WAKE_WORD_MODEL_PATH=

# Optional — only needed if you wire in the Gmail / Google Drive MCP servers
# (Phase 3). Get these from your Claude account's connector settings
# (claude.ai -> Settings -> Connectors -> Gmail / Google Drive -> copy the
# remote MCP server URL + issue yourself an OAuth token). Leave blank to
# skip Gmail/Drive tools entirely — the agent will just not register them.
GMAIL_MCP_URL=
GMAIL_MCP_TOKEN=
GDRIVE_MCP_URL=
GDRIVE_MCP_TOKEN=
