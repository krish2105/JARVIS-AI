# Copy this file to .env if you need to override any of these — Jarvis runs
# with zero keys and zero signups out of the box. Never commit .env.
#
# No Anthropic API key: reasoning runs entirely on a local MLX model (see
# config.yaml's `model:` section), downloaded once from Hugging Face and
# then fully offline.
#
# No Picovoice account either: the wake word uses openWakeWord, which is
# open-source and ships a pretrained "hey jarvis" model — downloaded once
# from its own model repo (free, no key) and cached locally.

# Wake word Jarvis listens for (matched against openWakeWord's model names,
# e.g. "jarvis" matches its bundled "hey_jarvis" model).
JARVIS_WAKE_WORD=jarvis

# Optional: path to a custom-trained openWakeWord model file, if you ever
# train your own instead of using the bundled "hey jarvis" model.
JARVIS_WAKE_WORD_MODEL_PATH=

# Optional: override the local LLMs set in config.yaml without editing it.
JARVIS_LOCAL_MODEL=
JARVIS_LOCAL_HEAVY_MODEL=
